+++ b/Python/pylifecycle.c
@@ -2,6 +2,9 @@
 
 #include "Python.h"
 
+#include "cpython/code.h"
+#include "frameobject.h"
+
 #include "pycore_ceval.h"         // _PyEval_FiniGIL()
 #include "pycore_context.h"       // _PyContext_Init()
 #include "pycore_exceptions.h"    // _PyExc_InitTypes()
@@ -33,6 +36,10 @@
 #include <locale.h>               // setlocale()
 #include <stdlib.h>               // getenv()
 
+#ifndef MS_WINDOWS
+#  include <unistd.h>             // getpid()
+#endif
+
 #if defined(__APPLE__)
 #include <mach-o/loader.h>
 #endif
@@ -69,6 +76,577 @@ static PyStatus init_sys_streams(PyThreadState *tstate);
 static void wait_for_thread_shutdown(PyThreadState *tstate);
 static void call_ll_exitfuncs(_PyRuntimeState *runtime);
 
+static FILE *agentic_events_file = NULL;
+static long agentic_commands_offset = 0;
+static int agentic_waiting_for_resume = 0;
+static int agentic_break_mode = 0;
+static int agentic_break_once = 0;
+static int agentic_step_mode = 0;
+static int agentic_step_origin_depth = 0;
+static int agentic_filters_initialized = 0;
+static int agentic_filter_count = 0;
+static size_t agentic_filter_storage_used = 0;
+static char agentic_filter_storage[8192];
+static const char *agentic_filters[64];
+
+#define AGENTIC_BREAK_OFF 0
+#define AGENTIC_BREAK_LINE 1
+#define AGENTIC_BREAK_CALL 2
+#define AGENTIC_BREAK_RETURN 3
+#define AGENTIC_BREAK_EXCEPTION 4
+#define AGENTIC_BREAK_ALL 5
+
+#define AGENTIC_STEP_NONE 0
+#define AGENTIC_STEP_INTO 1
+#define AGENTIC_STEP_OVER 2
+#define AGENTIC_STEP_OUT 3
+
+static const char *
+agentic_trace_event_name(int what)
+{
+    switch (what) {
+    case PyTrace_CALL:
+        return "call";
+    case PyTrace_LINE:
+        return "line";
+    case PyTrace_RETURN:
+        return "return";
+    case PyTrace_EXCEPTION:
+        return "exception";
+    default:
+        return NULL;
+    }
+}
+
+static FILE *
+agentic_trace_events_file(void)
+{
+    if (agentic_events_file != NULL) {
+        return agentic_events_file;
+    }
+
+    char *path = Py_GETENV("PYTHON_AGENTIC_EVENTS");
+    if (path != NULL && path[0] != '\0') {
+        agentic_events_file = fopen(path, "a");
+        if (agentic_events_file != NULL) {
+            return agentic_events_file;
+        }
+    }
+    return stderr;
+}
+
+static void
+agentic_set_filters_from_tabs(const char *filters)
+{
+    agentic_filter_count = 0;
+    agentic_filter_storage[0] = '\0';
+    agentic_filter_storage_used = 0;
+    agentic_filters_initialized = 1;
+    if (filters == NULL || filters[0] == '\0' || strcmp(filters, "all") == 0) {
+        return;
+    }
+
+    size_t length = strlen(filters);
+    if (length >= sizeof(agentic_filter_storage)) {
+        length = sizeof(agentic_filter_storage) - 1;
+    }
+    memcpy(agentic_filter_storage, filters, length);
+    agentic_filter_storage[length] = '\0';
+    agentic_filter_storage_used = length + 1;
+
+    char *cursor = agentic_filter_storage;
+    while (cursor != NULL && *cursor != '\0' && agentic_filter_count < 64) {
+        char *separator = strchr(cursor, '\t');
+        if (separator != NULL) {
+            *separator = '\0';
+        }
+        if (*cursor != '\0') {
+            agentic_filters[agentic_filter_count] = cursor;
+            agentic_filter_count++;
+        }
+        if (separator == NULL) {
+            break;
+        }
+        cursor = separator + 1;
+    }
+}
+
+static void
+agentic_add_filter(const char *filter)
+{
+    if (filter == NULL || filter[0] == '\0' || agentic_filter_count >= 64) {
+        return;
+    }
+    if (!agentic_filters_initialized) {
+        agentic_set_filters_from_tabs(Py_GETENV("PYTHON_AGENTIC_FILTER"));
+    }
+    size_t used = agentic_filter_storage_used;
+    size_t length = strlen(filter);
+    if (used + length + 1 >= sizeof(agentic_filter_storage)) {
+        return;
+    }
+    char *destination = agentic_filter_storage + used;
+    memcpy(destination, filter, length + 1);
+    agentic_filters[agentic_filter_count] = destination;
+    agentic_filter_count++;
+    agentic_filter_storage_used = used + length + 1;
+}
+
+static void
+agentic_init_filters_if_needed(void)
+{
+    if (!agentic_filters_initialized) {
+        agentic_set_filters_from_tabs(Py_GETENV("PYTHON_AGENTIC_FILTER"));
+    }
+}
+
+static int
+agentic_filename_matches_filter(const char *filename)
+{
+    agentic_init_filters_if_needed();
+    if (agentic_filter_count == 0) {
+        return 1;
+    }
+    if (filename == NULL) {
+        return 0;
+    }
+    for (int i = 0; i < agentic_filter_count; i++) {
+        if (strstr(filename, agentic_filters[i]) != NULL) {
+            return 1;
+        }
+    }
+    return 0;
+}
+
+static int
+agentic_path_exists(const char *path)
+{
+    if (path == NULL || path[0] == '\0') {
+        return 0;
+    }
+#ifdef MS_WINDOWS
+    FILE *file = fopen(path, "r");
+    if (file == NULL) {
+        return 0;
+    }
+    fclose(file);
+    return 1;
+#else
+    return access(path, F_OK) == 0;
+#endif
+}
+
+static void
+agentic_strip_line(char *line)
+{
+    if (line == NULL) {
+        return;
+    }
+    size_t length = strlen(line);
+    while (length > 0 && (line[length - 1] == '\n' || line[length - 1] == '\r')) {
+        line[length - 1] = '\0';
+        length--;
+    }
+}
+
+static char *
+agentic_read_text_file(const char *path)
+{
+    FILE *file = fopen(path, "rb");
+    if (file == NULL) {
+        return NULL;
+    }
+    if (fseek(file, 0, SEEK_END) != 0) {
+        fclose(file);
+        return NULL;
+    }
+    long size = ftell(file);
+    if (size < 0) {
+        fclose(file);
+        return NULL;
+    }
+    if (fseek(file, 0, SEEK_SET) != 0) {
+        fclose(file);
+        return NULL;
+    }
+    char *buffer = (char *)PyMem_RawMalloc((size_t)size + 1);
+    if (buffer == NULL) {
+        fclose(file);
+        return NULL;
+    }
+    size_t read = fread(buffer, 1, (size_t)size, file);
+    fclose(file);
+    buffer[read] = '\0';
+    return buffer;
+}
+
+static void
+agentic_execute_code_file(PyFrameObject *frame, const char *path)
+{
+    if (frame == NULL || path == NULL || path[0] == '\0') {
+        return;
+    }
+    char *code = agentic_read_text_file(path);
+    if (code == NULL) {
+        return;
+    }
+
+    PyObject *globals = PyFrame_GetGlobals(frame);
+    PyObject *locals = PyFrame_GetLocals(frame);
+    if (globals == NULL || locals == NULL) {
+        PyErr_Clear();
+        Py_XDECREF(globals);
+        Py_XDECREF(locals);
+        PyMem_RawFree(code);
+        return;
+    }
+
+    PyObject *result = PyRun_StringFlags(code, Py_file_input, globals, locals, NULL);
+    if (result == NULL) {
+        PyErr_PrintEx(0);
+    }
+    else {
+        Py_DECREF(result);
+    }
+    Py_DECREF(globals);
+    Py_DECREF(locals);
+    PyMem_RawFree(code);
+}
+
+static void
+agentic_set_break_mode(const char *mode)
+{
+    if (mode == NULL) {
+        return;
+    }
+    if (strcmp(mode, "off") == 0 || strcmp(mode, "none") == 0) {
+        agentic_break_mode = AGENTIC_BREAK_OFF;
+        agentic_break_once = 0;
+    }
+    else if (strcmp(mode, "line") == 0) {
+        agentic_break_mode = AGENTIC_BREAK_LINE;
+        agentic_break_once = 0;
+    }
+    else if (strcmp(mode, "call") == 0) {
+        agentic_break_mode = AGENTIC_BREAK_CALL;
+        agentic_break_once = 0;
+    }
+    else if (strcmp(mode, "return") == 0) {
+        agentic_break_mode = AGENTIC_BREAK_RETURN;
+        agentic_break_once = 0;
+    }
+    else if (strcmp(mode, "exception") == 0) {
+        agentic_break_mode = AGENTIC_BREAK_EXCEPTION;
+        agentic_break_once = 0;
+    }
+    else if (strcmp(mode, "all") == 0) {
+        agentic_break_mode = AGENTIC_BREAK_ALL;
+        agentic_break_once = 0;
+    }
+}
+
+static void
+agentic_set_break_once(const char *mode)
+{
+    agentic_set_break_mode(mode);
+    if (agentic_break_mode != AGENTIC_BREAK_OFF) {
+        agentic_break_once = 1;
+    }
+}
+
+static int
+agentic_frame_depth(PyFrameObject *frame)
+{
+    int depth = 0;
+    PyFrameObject *cursor = frame;
+    Py_XINCREF(cursor);
+    while (cursor != NULL) {
+        depth++;
+        PyFrameObject *back = PyFrame_GetBack(cursor);
+        Py_DECREF(cursor);
+        cursor = back;
+    }
+    return depth;
+}
+
+static void
+agentic_set_step_mode(PyFrameObject *frame, const char *mode)
+{
+    if (mode == NULL) {
+        return;
+    }
+    if (strcmp(mode, "none") == 0 || strcmp(mode, "off") == 0) {
+        agentic_step_mode = AGENTIC_STEP_NONE;
+        agentic_step_origin_depth = 0;
+    }
+    else if (strcmp(mode, "into") == 0 || strcmp(mode, "step") == 0) {
+        agentic_step_mode = AGENTIC_STEP_INTO;
+        agentic_step_origin_depth = agentic_frame_depth(frame);
+    }
+    else if (strcmp(mode, "over") == 0 || strcmp(mode, "next") == 0) {
+        agentic_step_mode = AGENTIC_STEP_OVER;
+        agentic_step_origin_depth = agentic_frame_depth(frame);
+    }
+    else if (strcmp(mode, "out") == 0) {
+        agentic_step_mode = AGENTIC_STEP_OUT;
+        agentic_step_origin_depth = agentic_frame_depth(frame);
+    }
+}
+
+static void
+agentic_apply_command(PyFrameObject *frame, char *line)
+{
+    if (strncmp(line, "exec_file\t", 10) == 0) {
+        agentic_execute_code_file(frame, line + 10);
+    }
+    else if (strncmp(line, "set_filters\t", 12) == 0) {
+        agentic_set_filters_from_tabs(line + 12);
+    }
+    else if (strcmp(line, "clear_filters") == 0) {
+        agentic_set_filters_from_tabs(NULL);
+    }
+    else if (strncmp(line, "add_filter\t", 11) == 0) {
+        agentic_add_filter(line + 11);
+    }
+    else if (strncmp(line, "set_break_mode\t", 15) == 0) {
+        agentic_set_break_mode(line + 15);
+    }
+    else if (strncmp(line, "set_break_once\t", 15) == 0) {
+        agentic_set_break_once(line + 15);
+    }
+    else if (strncmp(line, "set_step_mode\t", 14) == 0) {
+        agentic_set_step_mode(frame, line + 14);
+    }
+    else if (strcmp(line, "resume") == 0 || strcmp(line, "continue") == 0) {
+        agentic_waiting_for_resume = 0;
+    }
+    else if (strcmp(line, "pause") == 0) {
+        agentic_waiting_for_resume = 1;
+    }
+}
+
+static void
+agentic_poll_commands(PyFrameObject *frame)
+{
+    char *path = Py_GETENV("PYTHON_AGENTIC_COMMANDS");
+    if (path == NULL || path[0] == '\0') {
+        return;
+    }
+
+    FILE *file = fopen(path, "r");
+    if (file == NULL) {
+        return;
+    }
+    if (agentic_commands_offset > 0) {
+        if (fseek(file, agentic_commands_offset, SEEK_SET) != 0) {
+            fclose(file);
+            return;
+        }
+    }
+
+    char line[4096];
+    while (fgets(line, sizeof(line), file) != NULL) {
+        agentic_strip_line(line);
+        agentic_apply_command(frame, line);
+    }
+    long offset = ftell(file);
+    if (offset >= 0) {
+        agentic_commands_offset = offset;
+    }
+    fclose(file);
+}
+
+static int
+agentic_break_mode_matches(int what)
+{
+    if (agentic_break_mode == AGENTIC_BREAK_ALL) {
+        return 1;
+    }
+    if (agentic_break_mode == AGENTIC_BREAK_LINE && what == PyTrace_LINE) {
+        return 1;
+    }
+    if (agentic_break_mode == AGENTIC_BREAK_CALL && what == PyTrace_CALL) {
+        return 1;
+    }
+    if (agentic_break_mode == AGENTIC_BREAK_RETURN && what == PyTrace_RETURN) {
+        return 1;
+    }
+    if (agentic_break_mode == AGENTIC_BREAK_EXCEPTION && what == PyTrace_EXCEPTION) {
+        return 1;
+    }
+    return 0;
+}
+
+static int
+agentic_step_mode_matches(PyFrameObject *frame, int what)
+{
+    if (agentic_step_mode == AGENTIC_STEP_NONE) {
+        return 0;
+    }
+    int depth = agentic_frame_depth(frame);
+    if (agentic_step_mode == AGENTIC_STEP_INTO && what == PyTrace_LINE) {
+        agentic_step_mode = AGENTIC_STEP_NONE;
+        return 1;
+    }
+    if (agentic_step_mode == AGENTIC_STEP_OVER && what == PyTrace_LINE &&
+        depth <= agentic_step_origin_depth)
+    {
+        agentic_step_mode = AGENTIC_STEP_NONE;
+        return 1;
+    }
+    if (agentic_step_mode == AGENTIC_STEP_OUT &&
+        ((what == PyTrace_RETURN && depth <= agentic_step_origin_depth) ||
+         (what == PyTrace_LINE && depth < agentic_step_origin_depth)))
+    {
+        agentic_step_mode = AGENTIC_STEP_NONE;
+        return 1;
+    }
+    return 0;
+}
+
+static void
+agentic_wait_if_paused(PyFrameObject *frame)
+{
+    char *pause_path = Py_GETENV("PYTHON_AGENTIC_PAUSE_FILE");
+    while (agentic_waiting_for_resume ||
+           (pause_path != NULL && pause_path[0] != '\0' && agentic_path_exists(pause_path)))
+    {
+        agentic_poll_commands(frame);
+#ifndef MS_WINDOWS
+        usleep(50000);
+#endif
+    }
+}
+
+static void
+agentic_write_json_string(FILE *file, const char *value)
+{
+    fputc('"', file);
+    if (value != NULL) {
+        for (const unsigned char *p = (const unsigned char *)value; *p != '\0'; p++) {
+            switch (*p) {
+            case '"':
+                fputs("\\\"", file);
+                break;
+            case '\\':
+                fputs("\\\\", file);
+                break;
+            case '\b':
+                fputs("\\b", file);
+                break;
+            case '\f':
+                fputs("\\f", file);
+                break;
+            case '\n':
+                fputs("\\n", file);
+                break;
+            case '\r':
+                fputs("\\r", file);
+                break;
+            case '\t':
+                fputs("\\t", file);
+                break;
+            default:
+                if (*p < 0x20) {
+                    fprintf(file, "\\u%04x", *p);
+                }
+                else {
+                    fputc(*p, file);
+                }
+            }
+        }
+    }
+    fputc('"', file);
+}
+
+static int
+agentic_trace_func(PyObject *obj, PyFrameObject *frame, int what, PyObject *arg)
+{
+    (void)obj;
+    (void)arg;
+
+    const char *event = agentic_trace_event_name(what);
+    if (event == NULL || frame == NULL) {
+        return 0;
+    }
+
+    PyObject *exc_type = NULL;
+    PyObject *exc_value = NULL;
+    PyObject *exc_tb = NULL;
+    PyErr_Fetch(&exc_type, &exc_value, &exc_tb);
+
+    const char *filename = "<unknown>";
+    const char *function = "<unknown>";
+    PyCodeObject *code = PyFrame_GetCode(frame);
+    if (code != NULL) {
+        const char *candidate = PyUnicode_AsUTF8(code->co_filename);
+        if (candidate != NULL) {
+            filename = candidate;
+        }
+        candidate = PyUnicode_AsUTF8(code->co_name);
+        if (candidate != NULL) {
+            function = candidate;
+        }
+    }
+    if (!agentic_filename_matches_filter(filename)) {
+        Py_XDECREF(code);
+        PyErr_Restore(exc_type, exc_value, exc_tb);
+        return 0;
+    }
+
+    FILE *file = agentic_trace_events_file();
+    if (file != NULL) {
+        char *run_id = Py_GETENV("PYTHON_AGENTIC_RUN_ID");
+        if (run_id == NULL || run_id[0] == '\0') {
+            run_id = "agentic";
+        }
+#ifdef MS_WINDOWS
+        int process_id = 0;
+#else
+        int process_id = (int)getpid();
+#endif
+        int lineno = PyFrame_GetLineNumber(frame);
+
+        fputs("{\"protocol_version\":1,\"event\":", file);
+        agentic_write_json_string(file, event);
+        fputs(",\"run_id\":", file);
+        agentic_write_json_string(file, run_id);
+        fprintf(file, ",\"process_id\":%d", process_id);
+        fprintf(file, ",\"frame_id\":\"%p\"", (void *)frame);
+        fputs(",\"filename\":", file);
+        agentic_write_json_string(file, filename);
+        fputs(",\"function\":", file);
+        agentic_write_json_string(file, function);
+        fprintf(file, ",\"lineno\":%d}\n", lineno);
+        fflush(file);
+    }
+
+    agentic_poll_commands(frame);
+    int break_matches = agentic_break_mode_matches(what);
+    int step_matches = agentic_step_mode_matches(frame, what);
+    if (break_matches || step_matches) {
+        if (break_matches && agentic_break_once) {
+            agentic_break_mode = AGENTIC_BREAK_OFF;
+            agentic_break_once = 0;
+        }
+        agentic_waiting_for_resume = 1;
+    }
+    agentic_wait_if_paused(frame);
+
+    Py_XDECREF(code);
+    PyErr_Restore(exc_type, exc_value, exc_tb);
+    return 0;
+}
+
+static void
+agentic_install_trace_if_enabled(void)
+{
+    char *enabled = Py_GETENV("PYTHON_AGENTIC");
+    if (enabled != NULL && enabled[0] != '\0') {
+        PyEval_SetTrace(agentic_trace_func, NULL);
+    }
+}
+
 /* The following places the `_PyRuntime` structure in a location that can be
  * found without any external information. This is meant to ease access to the
  * interpreter state for various runtime debugging tools, but is *not* an
@@ -1311,6 +1889,7 @@ Py_InitializeFromConfig(const PyConfig *config)
         if (_PyStatus_EXCEPTION(status)) {
             return status;
         }
+        agentic_install_trace_if_enabled();
     }
 
     return _PyStatus_OK();
