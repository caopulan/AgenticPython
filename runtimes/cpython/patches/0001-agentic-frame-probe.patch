@@ -2,6 +2,9 @@
 
 #include "Python.h"
 
+#include "cpython/code.h"
+#include "frameobject.h"
+
 #include "pycore_ceval.h"         // _PyEval_FiniGIL()
 #include "pycore_context.h"       // _PyContext_Init()
 #include "pycore_exceptions.h"    // _PyExc_InitTypes()
@@ -33,6 +36,10 @@
 #include <locale.h>               // setlocale()
 #include <stdlib.h>               // getenv()
 
+#ifndef MS_WINDOWS
+#  include <unistd.h>             // getpid()
+#endif
+
 #if defined(__APPLE__)
 #include <mach-o/loader.h>
 #endif
@@ -69,6 +76,319 @@ static PyStatus init_sys_streams(PyThreadState *tstate);
 static void wait_for_thread_shutdown(PyThreadState *tstate);
 static void call_ll_exitfuncs(_PyRuntimeState *runtime);
 
+static FILE *agentic_events_file = NULL;
+static long agentic_commands_offset = 0;
+
+static const char *
+agentic_trace_event_name(int what)
+{
+    switch (what) {
+    case PyTrace_CALL:
+        return "call";
+    case PyTrace_LINE:
+        return "line";
+    case PyTrace_RETURN:
+        return "return";
+    case PyTrace_EXCEPTION:
+        return "exception";
+    default:
+        return NULL;
+    }
+}
+
+static FILE *
+agentic_trace_events_file(void)
+{
+    if (agentic_events_file != NULL) {
+        return agentic_events_file;
+    }
+
+    char *path = Py_GETENV("PYTHON_AGENTIC_EVENTS");
+    if (path != NULL && path[0] != '\0') {
+        agentic_events_file = fopen(path, "a");
+        if (agentic_events_file != NULL) {
+            return agentic_events_file;
+        }
+    }
+    return stderr;
+}
+
+static int
+agentic_filename_matches_filter(const char *filename)
+{
+    char *filter = Py_GETENV("PYTHON_AGENTIC_FILTER");
+    if (filter == NULL || filter[0] == '\0') {
+        return 1;
+    }
+    if (filename == NULL) {
+        return 0;
+    }
+    return strstr(filename, filter) != NULL;
+}
+
+static int
+agentic_path_exists(const char *path)
+{
+    if (path == NULL || path[0] == '\0') {
+        return 0;
+    }
+#ifdef MS_WINDOWS
+    FILE *file = fopen(path, "r");
+    if (file == NULL) {
+        return 0;
+    }
+    fclose(file);
+    return 1;
+#else
+    return access(path, F_OK) == 0;
+#endif
+}
+
+static void
+agentic_strip_line(char *line)
+{
+    if (line == NULL) {
+        return;
+    }
+    size_t length = strlen(line);
+    while (length > 0 && (line[length - 1] == '\n' || line[length - 1] == '\r')) {
+        line[length - 1] = '\0';
+        length--;
+    }
+}
+
+static char *
+agentic_read_text_file(const char *path)
+{
+    FILE *file = fopen(path, "rb");
+    if (file == NULL) {
+        return NULL;
+    }
+    if (fseek(file, 0, SEEK_END) != 0) {
+        fclose(file);
+        return NULL;
+    }
+    long size = ftell(file);
+    if (size < 0) {
+        fclose(file);
+        return NULL;
+    }
+    if (fseek(file, 0, SEEK_SET) != 0) {
+        fclose(file);
+        return NULL;
+    }
+    char *buffer = (char *)PyMem_RawMalloc((size_t)size + 1);
+    if (buffer == NULL) {
+        fclose(file);
+        return NULL;
+    }
+    size_t read = fread(buffer, 1, (size_t)size, file);
+    fclose(file);
+    buffer[read] = '\0';
+    return buffer;
+}
+
+static void
+agentic_execute_code_file(PyFrameObject *frame, const char *path)
+{
+    if (frame == NULL || path == NULL || path[0] == '\0') {
+        return;
+    }
+    char *code = agentic_read_text_file(path);
+    if (code == NULL) {
+        return;
+    }
+
+    PyObject *globals = PyFrame_GetGlobals(frame);
+    PyObject *locals = PyFrame_GetLocals(frame);
+    if (globals == NULL || locals == NULL) {
+        PyErr_Clear();
+        Py_XDECREF(globals);
+        Py_XDECREF(locals);
+        PyMem_RawFree(code);
+        return;
+    }
+
+    PyObject *result = PyRun_StringFlags(code, Py_file_input, globals, locals, NULL);
+    if (result == NULL) {
+        PyErr_PrintEx(0);
+    }
+    else {
+        Py_DECREF(result);
+    }
+    Py_DECREF(globals);
+    Py_DECREF(locals);
+    PyMem_RawFree(code);
+}
+
+static void
+agentic_poll_commands(PyFrameObject *frame)
+{
+    char *path = Py_GETENV("PYTHON_AGENTIC_COMMANDS");
+    if (path == NULL || path[0] == '\0') {
+        return;
+    }
+
+    FILE *file = fopen(path, "r");
+    if (file == NULL) {
+        return;
+    }
+    if (agentic_commands_offset > 0) {
+        if (fseek(file, agentic_commands_offset, SEEK_SET) != 0) {
+            fclose(file);
+            return;
+        }
+    }
+
+    char line[4096];
+    while (fgets(line, sizeof(line), file) != NULL) {
+        agentic_strip_line(line);
+        if (strncmp(line, "exec_file\t", 10) == 0) {
+            agentic_execute_code_file(frame, line + 10);
+        }
+    }
+    long offset = ftell(file);
+    if (offset >= 0) {
+        agentic_commands_offset = offset;
+    }
+    fclose(file);
+}
+
+static void
+agentic_wait_if_paused(PyFrameObject *frame)
+{
+    char *pause_path = Py_GETENV("PYTHON_AGENTIC_PAUSE_FILE");
+    if (pause_path == NULL || pause_path[0] == '\0') {
+        return;
+    }
+    while (agentic_path_exists(pause_path)) {
+        agentic_poll_commands(frame);
+#ifndef MS_WINDOWS
+        usleep(50000);
+#endif
+    }
+}
+
+static void
+agentic_write_json_string(FILE *file, const char *value)
+{
+    fputc('"', file);
+    if (value != NULL) {
+        for (const unsigned char *p = (const unsigned char *)value; *p != '\0'; p++) {
+            switch (*p) {
+            case '"':
+                fputs("\\\"", file);
+                break;
+            case '\\':
+                fputs("\\\\", file);
+                break;
+            case '\b':
+                fputs("\\b", file);
+                break;
+            case '\f':
+                fputs("\\f", file);
+                break;
+            case '\n':
+                fputs("\\n", file);
+                break;
+            case '\r':
+                fputs("\\r", file);
+                break;
+            case '\t':
+                fputs("\\t", file);
+                break;
+            default:
+                if (*p < 0x20) {
+                    fprintf(file, "\\u%04x", *p);
+                }
+                else {
+                    fputc(*p, file);
+                }
+            }
+        }
+    }
+    fputc('"', file);
+}
+
+static int
+agentic_trace_func(PyObject *obj, PyFrameObject *frame, int what, PyObject *arg)
+{
+    (void)obj;
+    (void)arg;
+
+    const char *event = agentic_trace_event_name(what);
+    if (event == NULL || frame == NULL) {
+        return 0;
+    }
+
+    PyObject *exc_type = NULL;
+    PyObject *exc_value = NULL;
+    PyObject *exc_tb = NULL;
+    PyErr_Fetch(&exc_type, &exc_value, &exc_tb);
+
+    const char *filename = "<unknown>";
+    const char *function = "<unknown>";
+    PyCodeObject *code = PyFrame_GetCode(frame);
+    if (code != NULL) {
+        const char *candidate = PyUnicode_AsUTF8(code->co_filename);
+        if (candidate != NULL) {
+            filename = candidate;
+        }
+        candidate = PyUnicode_AsUTF8(code->co_name);
+        if (candidate != NULL) {
+            function = candidate;
+        }
+    }
+    if (!agentic_filename_matches_filter(filename)) {
+        Py_XDECREF(code);
+        PyErr_Restore(exc_type, exc_value, exc_tb);
+        return 0;
+    }
+
+    FILE *file = agentic_trace_events_file();
+    if (file != NULL) {
+        char *run_id = Py_GETENV("PYTHON_AGENTIC_RUN_ID");
+        if (run_id == NULL || run_id[0] == '\0') {
+            run_id = "agentic";
+        }
+#ifdef MS_WINDOWS
+        int process_id = 0;
+#else
+        int process_id = (int)getpid();
+#endif
+        int lineno = PyFrame_GetLineNumber(frame);
+
+        fputs("{\"protocol_version\":1,\"event\":", file);
+        agentic_write_json_string(file, event);
+        fputs(",\"run_id\":", file);
+        agentic_write_json_string(file, run_id);
+        fprintf(file, ",\"process_id\":%d", process_id);
+        fprintf(file, ",\"frame_id\":\"%p\"", (void *)frame);
+        fputs(",\"filename\":", file);
+        agentic_write_json_string(file, filename);
+        fputs(",\"function\":", file);
+        agentic_write_json_string(file, function);
+        fprintf(file, ",\"lineno\":%d}\n", lineno);
+        fflush(file);
+    }
+
+    agentic_poll_commands(frame);
+    agentic_wait_if_paused(frame);
+
+    Py_XDECREF(code);
+    PyErr_Restore(exc_type, exc_value, exc_tb);
+    return 0;
+}
+
+static void
+agentic_install_trace_if_enabled(void)
+{
+    char *enabled = Py_GETENV("PYTHON_AGENTIC");
+    if (enabled != NULL && enabled[0] != '\0') {
+        PyEval_SetTrace(agentic_trace_func, NULL);
+    }
+}
+
 /* The following places the `_PyRuntime` structure in a location that can be
  * found without any external information. This is meant to ease access to the
  * interpreter state for various runtime debugging tools, but is *not* an
@@ -1311,6 +1631,7 @@ Py_InitializeFromConfig(const PyConfig *config)
         if (_PyStatus_EXCEPTION(status)) {
             return status;
         }
+        agentic_install_trace_if_enabled();
     }
 
     return _PyStatus_OK();
